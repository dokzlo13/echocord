{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echocord Desktop Probe",
  "version": "0.1.0",
  "identifier": "invalid.echocord.desktop-probe",
  "build": {
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "probe",
        "title": "Echocord desktop dependency probe",
        "width": 560,
        "height": 280,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../dist/probe.ico"]
  }
}
