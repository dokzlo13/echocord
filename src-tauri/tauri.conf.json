{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echocord",
  "version": "0.1.0",
  "identifier": "app.echocord.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "windows": { "staticVCRuntime": false }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Echocord",
        "width": 480,
        "height": 600,
        "minWidth": 420,
        "minHeight": 540,
        "backgroundColor": "#242e36",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.discordapp.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["../ui/dist/echocord.ico"] }
}
