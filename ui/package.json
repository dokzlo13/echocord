{
  "name": "echocord-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode fixture --host 127.0.0.1",
    "dev:native": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "npm run typecheck && vite build",
    "test": "npm run build && playwright test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@fontsource-variable/sofia-sans": "5.3.0",
    "@fontsource-variable/sofia-sans-condensed": "5.3.0",
    "lucide-react": "1.55.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
